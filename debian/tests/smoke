#!/bin/sh
set -eu

test -f /usr/lib/udev/rules.d/61-yogabook-sensors.rules
test -f /usr/lib/udev/hwdb.d/61-yogabook-sensors.hwdb
test -f /usr/share/doc/yogabook-sensors/ATTRIBUTION.md
test -f /usr/share/doc/yogabook-sensors/README.md

udevadm verify --no-style --no-summary \
    /usr/lib/udev/rules.d/61-yogabook-sensors.rules

display=$(systemd-hwdb query \
    'sensor:modalias:platform:HID-SENSOR-200073:id:HID-SENSOR-200073.10.auto:dmi:bvnLENOVO:pnLenovoYB1-X91L:')
printf '%s\n' "$display" | grep -Fqx 'ACCEL_LOCATION=display'
printf '%s\n' "$display" |
    grep -Fqx 'ACCEL_MOUNT_MATRIX=0, -1, 0; 1, 0, 0; 0, 0, 1'

base=$(systemd-hwdb query \
    'sensor:modalias:platform:HID-SENSOR-200073:id:HID-SENSOR-200073.11.auto:dmi:bvnLENOVO:pnLenovoYB1-X91L:')
printf '%s\n' "$base" | grep -Fqx 'ACCEL_LOCATION=base'
printf '%s\n' "$base" |
    grep -Fqx 'ACCEL_MOUNT_MATRIX=0, 1, 0; -1, 0, 0; 0, 0, 1'

proximity=$(systemd-hwdb query \
    'sensor:modalias:acpi:STH9310::dmi:bvnLENOVO:pnLenovoYB1-X91L:')
printf '%s\n' "$proximity" | grep -Fqx 'PROXIMITY_NEAR_LEVEL=96'
